# Notion integration token (see README "Notion setup" section)
NOTION_API_KEY=

# ID of the Notion database that Zapier writes Fathom calls into
NOTION_DATABASE_ID=

# Property names in that Notion database (only change these if your
# database uses different column names than the defaults below)
NOTION_PROP_COMPANY=Company
NOTION_PROP_DATE=Call Date
NOTION_PROP_SUMMARY=Summary

# Optional: set this if your Notion database has an email column and you
# want to match customers by email instead of/in addition to company name
NOTION_PROP_EMAIL=
